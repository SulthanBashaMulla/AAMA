rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: read the caller's role from their user document ──────────────
    // Declared once to avoid repeating the get() call throughout rules.
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isElevated() {
      return request.auth != null && userRole() in ['faculty', 'admin'];
    }

    // ── users collection ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile; faculty and admin can read any profile
      allow read: if request.auth != null
                  && (request.auth.uid == userId || userRole() in ['faculty', 'admin']);

      // Signup can never self-create an elevated role.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'student';

      // A student can only edit profile fields. Role upgrades require a
      // separately validated request whose code matches config/inviteCodes.
      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['name', 'email', 'rollNumber', 'department'])
                      )
                      || (
                        isElevated()
                        && request.resource.data.role in ['faculty', 'admin']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                      )
                      || (
                        request.auth.uid == userId
                        && resource.data.role == 'student'
                        && request.resource.data.role in ['faculty', 'admin']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                        && exists(/databases/$(database)/documents/roleUpgradeRequests/$(userId))
                        && get(/databases/$(database)/documents/roleUpgradeRequests/$(userId)).data.role == request.resource.data.role
                      )
                    );

      // No deletion via client SDK
      allow delete: if false;
    }

    // ── activities collection ─────────────────────────────────────────────────
    match /activities/{activityId} {

      // ── CREATE: Students can only create their own activity ─────────────────
      // Correction #2: Constrain initial values so a student cannot
      // self-approve or self-award points by sending fabricated fields.
      //   - studentId must equal the authenticated user's UID
      //   - status must be 'pending'  (not 'approved')
      //   - points must be 0          (not a self-awarded value)
      allow create: if request.auth != null
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status   == 'pending'
                    && request.resource.data.points   == 0;

      // ── READ: Students read their own; faculty/admin read all ───────────────
      allow read: if request.auth != null
                  && (
                    request.auth.uid == resource.data.studentId
                    || userRole() in ['faculty', 'admin']
                  );

      // ── UPDATE: Only faculty and admin can update (approve/reject) ──────────
      // Students cannot touch status, points, reviewedBy, reviewedAt, or
      // reviewComment — only faculty/admin can write these fields.
      allow update: if request.auth != null
                    && userRole() in ['faculty', 'admin'];

      // ── DELETE: Disallowed for all roles ────────────────────────────────────
      allow delete: if false;
    }

    // The client cannot read or write invite configuration directly. A
    // request is accepted only when its code matches the server-side value.
    match /config/inviteCodes {
      allow read, write: if false;
    }

    match /roleUpgradeRequests/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['role', 'code'])
                    && request.resource.data.role in ['faculty', 'admin']
                    && request.resource.data.code == get(/databases/$(database)/documents/config/inviteCodes).data[
                      request.resource.data.role == 'faculty' ? 'facultyCode' : 'adminCode'
                    ];
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow read, update: if false;
    }
  }
}
